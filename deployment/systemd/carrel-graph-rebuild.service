# Installed from __CARREL_HOME__/deployment/systemd by scripts/install-systemd.sh; the path marks which checkout owns this unit.
[Unit]
Description=Carrel: graph maintenance check (append new documents, rebuild policy)
After=network-online.target

[Service]
# Only a backstop for a real hang, so far above one normal build: a full rebuild of the largest knowledge base
# measured 2-3 hours (2026-09, hosted LLM at concurrency 128), and lower concurrency or a slower provider
# stretches that several times over. Aligned with the console path's KB_GRAPH_BUILD_MAX_HOURS at 48 hours.
# A yield (this KB is parsing) does not sleep and retry inside the script; the next round (2 hours later)
# comes by itself.
TimeoutStartSec=172800
Environment=PYTHONUNBUFFERED=1
Type=oneshot
# Batch job: under memory pressure it is killed before the always-on console and search service (100).
# Written out rather than left to the systemd default.
OOMScoreAdjust=200
WorkingDirectory=__CARREL_HOME__
Environment=KB_LOCAL_BASE_DIR=__CARREL_HOME__
Environment=KB_ENV_FILE=__CARREL_HOME__/config/knowledge-base.env
# The wait for Qdrant at the start of the script probes ${QDRANT_URL}; that value used to be undefined in the
# unit's environment (only the KB_ENV_FILE path was), so it always probed 127.0.0.1:6333. Loading the env file
# itself into the environment makes the probe follow a changed URL (2026-09-06 health check B11). When Qdrant
# cannot be reached, ExecStartPre no longer exits 75 directly (which painted the unit failed every round while
# the services were deliberately stopped); the script counts the deferral and exits quietly instead, see
# scripts/lib/kb-maint-defer.sh for the policy.
EnvironmentFile=-__CARREL_HOME__/config/knowledge-base.env
ExecStart=/bin/bash __CARREL_HOME__/scripts/kb-graph-rebuild-check.sh