# Carrel compose settings. `deploy.sh` at the repo root copies this file to
# `.env` and fills in what it detects (GPU or CPU, registry mirror, memory
# tier, a random Neo4j password). Edit `.env`, not this file.

# ── which compose files and profiles to use (written by deploy.sh) ──
# GPU host:      COMPOSE_FILE=docker-compose.yml:compose.gpu.yml
# CPU-only host: COMPOSE_FILE=docker-compose.yml
COMPOSE_FILE=docker-compose.yml
# Add `local-models` to also run the five vLLM model servers on this box.
COMPOSE_PROFILES=

# ── network bindings ──
# Everything binds loopback. The pipeline runs on this host and the only
# LAN-facing surfaces are the web console (9800) and the search API (9810),
# which are started by the app, not by compose. Opening any of these to
# 0.0.0.0 hands the LAN unauthenticated access to the corpus or free GPU
# inference; do it deliberately or not at all.
MODEL_BIND_ADDRESS=127.0.0.1
QDRANT_BIND_ADDRESS=127.0.0.1
NEO4J_BIND_ADDRESS=127.0.0.1
OPENSEARCH_BIND_ADDRESS=127.0.0.1

# ── images (pinned; the app's clients are tested against these versions) ──
# deploy.sh prefixes Docker Hub names with a mirror when Docker Hub is not
# reachable from this host.
QDRANT_IMAGE=qdrant/qdrant:v1.18.2
NEO4J_IMAGE=neo4j:5.26.28-community
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.7.0
# vLLM image for the local-models profile. x86_64 hosts use the upstream
# image; NVIDIA DGX Spark (aarch64, Blackwell) needs NVIDIA's build,
# nvcr.io/nvidia/vllm:26.07-py3.
VLLM_IMAGE=vllm/vllm-openai:v0.21.0

# ── MinerU (parser) ──
MINERU_VERSION=3.4.4
# gpu: vLLM base image + both backends (pipeline and vlm-engine).
# cpu: slim Python image + pipeline backend only (no CUDA, much smaller).
MINERU_FLAVOR=gpu
MINERU_BASE_IMAGE=vllm/vllm-openai:v0.21.0
# Package index used while building the image (mirror for slow regions).
PIP_INDEX_URL=https://pypi.org/simple
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
# auto: vlm-engine when the container sees an NVIDIA GPU with at least
# MINERU_VLM_MIN_VRAM_GB of memory and compute capability MINERU_VLM_MIN_COMPUTE,
# pipeline otherwise. Set pipeline / vlm-engine / hybrid-engine to force one.
MINERU_BACKEND_POLICY=auto
MINERU_VLM_MIN_VRAM_GB=8
MINERU_VLM_MIN_COMPUTE=7.0
# vLLM memory share is derived from the GPU's total memory so that about this
# many GB go to the parser; set MINERU_GPU_MEMORY_UTILIZATION to override.
MINERU_VLM_TARGET_VRAM_GB=7
MINERU_GPU_MEMORY_UTILIZATION=
# auto: HuggingFace when reachable, otherwise ModelScope. Weights are
# downloaded once into MINERU_MODELS_PATH (default <repo>/models/mineru).
MINERU_MODEL_SOURCE=auto
MINERU_MODELS_PATH=../../models/mineru
MINERU_OUTPUT_PATH=../../runtime/mineru-output
MINERU_PORT=8765
MINERU_CUDA_VISIBLE_DEVICES=0
MINERU_MAX_MODEL_LEN=8192
MINERU_MAX_NUM_SEQS=16
MINERU_MAX_NUM_BATCHED_TOKENS=16384
MINERU_MM_PROCESSOR_CACHE_GB=1
MINERU_DTYPE=bfloat16
MINERU_API_MAX_CONCURRENT_REQUESTS=1
MINERU_PROCESSING_WINDOW_SIZE=64
MINERU_OMP_NUM_THREADS=4

# ── Qdrant ──
QDRANT_PORT=6333
QDRANT_DATA_PATH=../../runtime/qdrant_data
QDRANT_RUN_MODE=production
QDRANT_TELEMETRY_DISABLED=true
QDRANT_MEM_LIMIT=4g
QDRANT_MEM_RESERVATION=1g

# ── Neo4j (graph projection) ──
# deploy.sh generates the password and copies it into config/knowledge-base.env.
NEO4J_PASSWORD=
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=2G
NEO4J_PAGECACHE_SIZE=1G
NEO4J_USAGE_REPORT_ENABLED=false
NEO4J_DATA_PATH=../../runtime/neo4j/data
NEO4J_LOGS_PATH=../../runtime/neo4j/logs
NEO4J_PLUGINS_PATH=../../runtime/neo4j/plugins
NEO4J_IMPORT_PATH=../../runtime/neo4j/import
NEO4J_MEM_LIMIT=4g
NEO4J_MEM_RESERVATION=1g

# ── OpenSearch (keyword index) ──
OPENSEARCH_PORT=9200
OPENSEARCH_JAVA_HEAP=1g
OPENSEARCH_DATA_PATH=../../runtime/opensearch/data
OPENSEARCH_MEM_LIMIT=3g
OPENSEARCH_MEM_RESERVATION=1g

# ── local-models profile ──
# Weights are expected under <repo>/models/<name>; download them from
# HuggingFace or ModelScope first (see deployment/compose/README.md).
RAG_MEDIA_PATH=../../runtime/media
VLLM_USE_DEEP_GEMM=0
QWEN3_EMBEDDING_PORT=8101
QWEN3_EMBEDDING_MODEL_PATH=../../models/Qwen3-Embedding-0.6B
QWEN3_EMBEDDING_DTYPE=bfloat16
QWEN3_EMBEDDING_GPU_MEMORY_UTILIZATION=0.10
QWEN3_EMBEDDING_MAX_MODEL_LEN=8192
QWEN3_EMBEDDING_MAX_NUM_SEQS=32
QWEN3_EMBEDDING_MAX_NUM_BATCHED_TOKENS=49152
QWEN3_RERANKER_PORT=8102
QWEN3_RERANKER_MODEL_PATH=../../models/Qwen3-Reranker-0.6B
QWEN3_RERANKER_TEMPLATE_PATH=./assets/qwen3_reranker.jinja
QWEN3_RERANKER_DTYPE=bfloat16
QWEN3_RERANKER_GPU_MEMORY_UTILIZATION=0.10
QWEN3_RERANKER_MAX_MODEL_LEN=12288
QWEN3_RERANKER_MAX_NUM_SEQS=16
QWEN3_RERANKER_MAX_NUM_BATCHED_TOKENS=49152
QWEN3_VL_EMBEDDING_PORT=8103
QWEN3_VL_EMBEDDING_MODEL_PATH=../../models/Qwen3-VL-Embedding-2B
QWEN3_VL_EMBEDDING_DTYPE=bfloat16
QWEN3_VL_EMBEDDING_GPU_MEMORY_UTILIZATION=0.12
QWEN3_VL_EMBEDDING_MAX_MODEL_LEN=8192
QWEN3_VL_EMBEDDING_MAX_NUM_SEQS=6
QWEN3_VL_EMBEDDING_MAX_NUM_BATCHED_TOKENS=24576
QWEN3_VL_EMBEDDING_MM_PROCESSOR_CACHE_GB=1
QWEN3_VL_EMBEDDING_MAX_PIXELS=3686400
QWEN3_VL_EMBEDDING_MAX_FRAMES=32
QWEN3_VL_RERANKER_PORT=8104
QWEN3_VL_RERANKER_MODEL_PATH=../../models/Qwen3-VL-Reranker-2B
QWEN3_VL_RERANKER_TEMPLATE_PATH=./assets/qwen3_vl_reranker.jinja
QWEN3_VL_RERANKER_DTYPE=bfloat16
QWEN3_VL_RERANKER_GPU_MEMORY_UTILIZATION=0.15
QWEN3_VL_RERANKER_MAX_MODEL_LEN=12288
QWEN3_VL_RERANKER_MAX_NUM_SEQS=6
QWEN3_VL_RERANKER_MAX_NUM_BATCHED_TOKENS=36864
QWEN3_VL_RERANKER_MM_PROCESSOR_CACHE_GB=1
QWEN3_VL_RERANKER_MAX_PIXELS=3686400
QWEN3_VL_RERANKER_MAX_FRAMES=32
QWEN3_VL_INSTRUCT_PORT=8105
QWEN3_VL_INSTRUCT_MODEL_PATH=../../models/Qwen3-VL-8B-Instruct-FP8
QWEN3_VL_INSTRUCT_DTYPE=bfloat16
QWEN3_VL_INSTRUCT_QUANTIZATION=fp8
QWEN3_VL_INSTRUCT_GPU_MEMORY_UTILIZATION=0.18
QWEN3_VL_INSTRUCT_MAX_MODEL_LEN=8192
QWEN3_VL_INSTRUCT_MAX_NUM_SEQS=8
QWEN3_VL_INSTRUCT_MAX_NUM_BATCHED_TOKENS=16384
QWEN3_VL_INSTRUCT_MM_PROCESSOR_CACHE_GB=1
QWEN3_VL_INSTRUCT_MAX_PIXELS=3686400

# ── misc ──
TZ=UTC
