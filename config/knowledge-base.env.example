# Carrel runtime configuration.
#
# `deploy.sh` copies this file to config/knowledge-base.env (mode 600) and
# fills in the Neo4j password it generated. This is the single place for
# endpoints, credentials and tuning; the file is git-ignored.
#
# Paths default to the repository the app is installed from, so nothing here
# needs to be absolute. Uncomment a root only to move it elsewhere.

# ── roots ──
#KB_LOCAL_BASE_DIR=/path/to/carrel
#KB_MIRROR_ROOT=/path/to/carrel/runtime/mirror
#KB_STATE_DB=/path/to/carrel/runtime/state/kb-pipeline.db
#KB_RUNTIME_DIR=/path/to/carrel/runtime
#KB_CACHE_DIR=/path/to/carrel/runtime/parse_cache/kb-pipeline
#KB_LOG_DIR=/path/to/carrel/logs
#KB_GRAPH_WORK_DIR=/path/to/carrel/runtime/graph

# ── stores (the compose stack binds them to loopback) ──
QDRANT_URL=http://127.0.0.1:6333
# Only when your Qdrant asks for an API key (the bundled container does not).
#QDRANT_API_KEY=
OPENSEARCH_URL=http://127.0.0.1:9200
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── parsing ──
MINERU_SERVICE_URL=http://127.0.0.1:8765
# auto: use whichever backend the parser container chose for this machine
# (it writes runtime/mineru-output/carrel-mineru.json). Set pipeline,
# vlm-engine or hybrid-engine to force one, e.g. for a MinerU on another host.
MINERU_BACKEND=auto
# OCR language hint for the pipeline backend (ch covers mixed Chinese/English).
MINERU_LANG=ch
# Master switch for parsing: at 0 the worker leaves parse jobs in the queue
# (metadata, deletion and keyword-index jobs still run).
KB_PARSE_ENABLED=1
# Files younger than this are left alone so half-written uploads are not
# picked up. Raise it if your sync tool writes large files slowly.
KB_MIN_FILE_AGE_SECONDS=180
KB_LOCAL_SCAN_HASH=1
KB_SCAN_REQUIRE_FLAG=0
# Top-level folders that are symlinks are ignored unless this is 1 (a deliberate
# way to mount a folder from elsewhere). Inside a knowledge base, symlinks that
# leave the enrolled directory are always skipped.
KB_MIRROR_ALLOW_LINKED_DIRS=0
KB_JOB_MAX_RETRIES=5
KB_JOB_RETRY_BASE_SECONDS=300
KB_JOB_RETRY_MAX_SECONDS=3600
KB_PARSE_JOB_LEASE_SECONDS=64800
KB_METADATA_JOB_LEASE_SECONDS=3600
QDRANT_UPSERT_MAX_BYTES=31457280

# ── retention ──
# Soft-deleted points (and vanished knowledge bases) are kept this many days
# before the daily GC hard-deletes them: the undo window for deletions.
QDRANT_INACTIVE_RETENTION_DAYS=7
# Weekly cache rotation keeps this many past rotations; monthly log rotation
# keeps this many months. The shared VLM caption/vector cache has no age limit:
# the weekly cleanup drops an entry once no picture in the parse cache refers
# to it any more (file or knowledge base deleted, old version superseded).
KB_CACHE_ROTATION_KEEP=2
KB_LOG_ROTATION_KEEP_MONTHS=3
# The nightly maintenance round first copies the state database, the env files
# and the evaluation sets into backups/state/ and keeps this many copies.
KB_BACKUP_KEEP=7
# The weekly cleanup only touches this project's runtime, logs and backups. Set
# 1 to also clear the user's uv/pip caches and prune dangling Docker images.
KB_HOST_HOUSEKEEPING=0

# ── text embeddings (OpenAI-compatible /v1/embeddings) ──
# Any provider works. The dimension is baked into the Qdrant collections when
# they are created; changing the model later means re-ingesting everything.
EMBEDDING_BASE_URL=http://127.0.0.1:8101/v1
EMBEDDING_MODEL_ID=qwen3-embedding-0.6b
EMBEDDING_API_KEY=local
EMBEDDING_DIM=1024
EMBEDDING_BATCH=20
EMBEDDING_SLEEP_SECONDS=0
EMBEDDING_RETRY=5

# ── vision-language model for figure descriptions (OpenAI-compatible chat) ──
VLM_BASE_URL=http://127.0.0.1:8105/v1
VLM_MODEL_ID=qwen3-vl-8b-instruct-fp8
VLM_API_KEY=local
# With the bundled vLLM server, no higher than its --max-num-seqs
# (QWEN3_VL_INSTRUCT_MAX_NUM_SEQS in deployment/compose/.env, 6).
VLM_CONCURRENCY=6
VLM_TIMEOUT_SECONDS=300
VLM_TEMPERATURE=0.1
VLM_TOP_P=0.8
VLM_MAX_TOKENS=4096
# Ask for JSON output through the API's structured-output feature; turn it
# off for providers that do not support it.
VLM_STRUCTURED_OUTPUT=1

# ── visual vectors (optional, local vLLM only) ──
# Pictures the VLM described also get a pixel-level vector stored as the
# `visual` named vector next to the text vector. The request shape is
# vLLM's messages-style multimodal pooling, which hosted APIs do not offer:
# set VISUAL_EMBEDDING_ENABLED=0 unless you run the local-models profile.
VISUAL_EMBEDDING_ENABLED=0
VISUAL_EMBEDDING_BASE_URL=http://127.0.0.1:8103/v1
VISUAL_EMBEDDING_MODEL_ID=qwen3-vl-embedding-2b
VISUAL_EMBEDDING_API_KEY=local
VISUAL_EMBEDDING_DIM=2048
VISUAL_EMBEDDING_INSTRUCTION="Represent the user's input."
VISUAL_EMBEDDING_CONCURRENCY=2
VISUAL_EMBEDDING_RETRY=5
VISUAL_EMBEDDING_TIMEOUT_SECONDS=300
# Pixel budget applied before an image goes to either vision model.
KB_IMAGE_MAX_PIXELS=3686400

# ── rerankers (search side only; /v1/rerank as served by vLLM, TEI, Jina, Cohere) ──
# Leave empty when you have none: search then skips the rerank step.
RERANKER_BASE_URL=
VISUAL_RERANKER_BASE_URL=

# ── web console ──
# Listens on loopback by default. To use it from other devices set
# KB_WEB_HOST=0.0.0.0 AND a token: every /api call must then carry it as a
# Bearer header, and the console page asks for it once per browser.
KB_WEB_HOST=127.0.0.1
KB_WEB_PORT=9800
KB_WEB_TOKEN=
# Service rows the console manages (health probe + restart buttons). These are
# containers of the compose stack on this host. Add
# embedding,visual_embedding,vlm,reranker when you run the local-models profile.
KB_CONSOLE_SERVICES=database,mineru

NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1

# ── entity graph ──
# Days-only retention used by the manual tools (kb cleanup qdrant-graph-gc /
# neo4j-graph-gc). The end-of-build GC and the nightly graph-gc ignore age.
QDRANT_GRAPH_COLLECTION_RETENTION_DAYS=14
NEO4J_GRAPH_RETENTION_DAYS=14
# Graph versions kept per knowledge base, regardless of age: the active one
# plus this many minus one. 2 = the previous accepted version stays as a
# rollback target (kb graph rollback --source <key> --graph-version <old>,
# which also discards the rejected version). 1 = keep only the active version.
# Applied when a build finishes and by the nightly graph-gc (part of
# parse-assets-gc). The latest paused / failed version is kept for resuming
# and does not count towards N.
GRAPH_GC_KEEP_VERSIONS=2
# Seconds to wait after switching the live version before the superseded
# collections are deleted, so searches in flight at the switch can finish.
GRAPH_GC_GRACE_SECONDS=60
GRAPH_NEO4J_IMPORT_AFTER_BUILD=1
GRAPH_NEO4J_IMPORT_BATCH_SIZE=1000
# The LLM used for extraction is registered in the console's model registry.
# Concurrency, per-call timeout and the consecutive-failure circuit breaker:
KB_GRAPH_LLM_CONCURRENCY=8
KB_GRAPH_LLM_TIMEOUT=300
KB_GRAPH_CIRCUIT_FAILS=20

# ── search service (app/kb_search) ──
# Static bearer token; when empty only loopback requests are accepted.
# The search service re-reads this file every minute: the KB_SEARCH_* keys
# follow what the file says now, so a changed parameter or token needs no
# restart (HOST / PORT are the listening address and do need one, as do the
# keys in the other sections of this file, such as the service addresses).
# A key set explicitly in the process environment (a command-line prefix,
# systemd Environment=) still takes precedence over this file.
KB_SEARCH_HOST=0.0.0.0
KB_SEARCH_PORT=9810
KB_SEARCH_TOKEN=
# The tuning keys below take their defaults from app/kb_search/config.py when
# unset; the calibrated values live there, each with its date and basis.
# Uncomment only the key you want to change, after a `kb search eval`
# comparison; the values listed here are the code defaults (a test checks this).
# Candidates per channel / candidates sent to the reranker / results returned / RRF constant
# KB_SEARCH_VECTOR_K=50
# KB_SEARCH_BM25_K=30
# KB_SEARCH_GRAPH_K=60
# KB_SEARCH_VISUAL_K=20
# KB_SEARCH_RERANK_N=64
# KB_SEARCH_TOP_K=12
# KB_SEARCH_RRF_K=60
# Reranking: threshold 0.1 (floor = threshold x 0.7). Do not set it to 0: that
# turns off the out-of-scope verdict and the widening.
# KB_SEARCH_RERANK=1
# KB_SEARCH_RERANK_THRESHOLD=0.1
# KB_SEARCH_RERANK_WINDOW_TOKENS=480
# KB_SEARCH_RERANK_OVERLAP_TOKENS=32
# KB_SEARCH_FINAL_LEX_WEIGHT=0.2
# Graph expansion hops; the visual channel (it only runs when
# VISUAL_EMBEDDING_ENABLED=1 above)
# KB_SEARCH_GRAPH_HOPS=1
# KB_SEARCH_VISUAL=1
# KB_SEARCH_VISUAL_LOW_CONFIDENCE_FACTOR=0.85
# KB_SEARCH_VISUAL_QUOTA=3
# KB_SEARCH_VISUAL_ROUTE_WEIGHT=0.6
# Automatic knowledge-base routing: bases within GAP of the best score are
# queried together (at most MAX_KBS). When the vector evidence of every base
# is below FLOOR the result is only flagged routing.weak and the selection
# stays; when the selected bases produce no usable evidence (no candidates, or
# every rerank score below the floor) the search widens to all bases (WIDEN).
# KB_SEARCH_ROUTE_MAX_KBS=2
# KB_SEARCH_ROUTE_GAP=0.2
# KB_SEARCH_ROUTE_FLOOR=0.45
# KB_SEARCH_ROUTE_LEXICAL_WEIGHT=0.3
# KB_SEARCH_ROUTE_WIDEN=1
# Evidence assembly: text budget, neighbours, short-chunk stitching, MMR,
# quotas, down-weighting, compiled pages and fact hints
# KB_SEARCH_CONTEXT_TOKENS=6000
# KB_SEARCH_NEIGHBOR_SPAN=1
# KB_SEARCH_STITCH_MIN_CHARS=350
# KB_SEARCH_STITCH_MAX_CHARS=850
# KB_SEARCH_MMR=1
# KB_SEARCH_MMR_LAMBDA=0.7
# KB_SEARCH_QUOTA_MIN_HITS=2
# KB_SEARCH_QUOTA_MAX_BUCKETS=8
# KB_SEARCH_BOILERPLATE_FACTOR=0.5
# KB_SEARCH_HINT_BLOCK_BOOST=1.2
# KB_SEARCH_PAGE_TEXT_TOKENS=1200
# KB_SEARCH_SPEC_HINT_LIMIT=8
# How many subjects' one-hop graph neighbourhoods a search result carries (entities
# the question names first; 0 = none)
# KB_SEARCH_NEIGHBORHOODS=4
# Query-side task instruction (empty by default: the question is embedded as is)
# KB_SEARCH_QUERY_INSTRUCTION=
# Concurrency and timeouts (seconds): shared thread-pool size, time budget of a
# whole request (keep it below the caller's timeout; 0 = none), per-channel
# recall / embedding / rerank / visual-embedding timeouts, catalog cache
# KB_SEARCH_POOL_WORKERS=32
# KB_SEARCH_REQUEST_BUDGET=45
# KB_SEARCH_CHANNEL_TIMEOUT=25
# KB_SEARCH_EMBED_TIMEOUT=10
# KB_SEARCH_RERANK_TIMEOUT=20
# KB_SEARCH_VISUAL_TIMEOUT=20
# KB_SEARCH_CATALOG_TTL=60
