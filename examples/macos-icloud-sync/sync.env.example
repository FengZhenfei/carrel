# Settings for push-mirror.sh and icloud-prefetch.sh: copy to sync.env in this folder and edit.
# Both scripts read it with `source`, so quote values that contain spaces.

# The folder to push. Each subfolder becomes a knowledge base once enabled in the console.
# Finder's "iCloud Drive" is ~/Library/Mobile Documents/com~apple~CloudDocs on disk.
SYNC_SOURCE="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Knowledge Base"

# The server, as you would pass it to ssh: a Host alias from ~/.ssh/config, or user@host.
# Key-based login must work without a prompt: ssh -o BatchMode=yes <host> true
SYNC_HOST=carrel-server

# The Carrel checkout on the server. Relative paths are under the remote home directory.
SYNC_REMOTE_DIR=carrel
# The mirror, if KB_MIRROR_ROOT on the server points somewhere else than <checkout>/runtime/mirror:
# SYNC_REMOTE_MIRROR=carrel/runtime/mirror

# Optional, defaults shown.
# Keep equal to KB_MIRROR_LOCK_STALE_SECONDS on the server:
# SYNC_REMOTE_LOCK_STALE_SECONDS=3600
# SYNC_PUSH_LOCK_STALE_SECONDS=1800
# More folders to keep downloaded from iCloud, colon-separated (they are not pushed):
# SYNC_PREFETCH_EXTRA_ROOTS=
# SYNC_PREFETCH_LOCK_STALE_SECONDS=3600
# Seconds to wait for one file to download, how often to check, how often to ask again:
# SYNC_DOWNLOAD_WAIT_SECONDS=900
# SYNC_DOWNLOAD_POLL_SECONDS=5
# SYNC_DOWNLOAD_RETRY_SECONDS=60
# SYNC_READ_TIMEOUT_SECONDS=30
# Placeholders handled per round (0 = all):
# SYNC_PREFETCH_LIMIT=0
# Rotate each script's log at this size, keeping this many old copies:
# SYNC_LOG_MAX_KB=2048
# SYNC_LOG_KEEP=3
